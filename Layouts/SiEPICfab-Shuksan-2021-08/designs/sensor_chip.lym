            Point(pad_pin.x, pad_pin.y + i*(metal_width+metal_space)),
            Point(sensor_shifters[count].pinPoint('elec2').x-metal_space*1-metal_width*1, pad_pin.y + i*(metal_width+metal_space)),
            Point(sensor_shifters[count].pinPoint('elec2').x-metal_space*1-metal_width*1, sensor_pchd[count].pinPoint('elec2').y), 
            Point(sensor_shifters[count].pinPoint('elec2').x, sensor_pchd[count].pinPoint('elec2').y)], 
