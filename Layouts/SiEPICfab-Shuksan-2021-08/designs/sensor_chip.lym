        sensor_circuit_cells[count].shapes(metalLayer1N).insert(path)



    '''
    ########################################################################
    # PCHD electrical routing to the bond pads
    ########################################################################
    # sort the pchd metal escalators in order from top to bottom
    pchd_me.sort(key=lambda x: x.pinPoint('m_pin1').y, reverse=True)
    # find left and right bond pad column x values
    inst_bondpads_pchd.sort(key=lambda x: x.pinPoint('m_pin_left').x)
    pad_pin_leftcol_x = inst_bondpads_pchd[0].pinPoint('m_pin_left').x
    pad_pin_rightcol_x = inst_bondpads_pchd[-1].pinPoint('m_pin_left').x
    # sort the bondpads_pchd in order from right to left, then top to bottom y
    inst_bondpads_pchd.sort(key=lambda x: (x.pinPoint('m_pin_left').x, x.pinPoint('m_pin_left').y), reverse=True)
    
    r_dx_col1 = 0
    r_dx_col2 = 0
    r_dx_col1u = 0
    for i in range(0, len(sensor_circuit_cells)):
        pad_pin = inst_bondpads_pchd[i].pinPoint('m_pin_left')
        # text label
        sub_cell.shapes(textLayerN).insert(pya.Text("e_pchd_%s"%(i+1), inst_bondpads_pchd[i].trans)).text_size = 15/dbu
        sensor_circuit_cell = pchd_me[i].parent_cell
        if pchd_me[i].pinPoint('m_pin1').y &lt; pad_pin.y:
            # upper routes
            r_dx_col1u += -2*metal_width
            t = Trans(Trans.R0, pad_pin.x+r_dx_col1u, pchd_me[i].pinPoint('m_pin1').y)
            me3 = sensor_circuit_cell.insert(CellInstArray(metal_escalator.cell_index(), t))
            t = Trans(Trans.R0, pad_pin.x+r_dx_col1u, pad_pin.y)
            me4 = sensor_circuit_cell.insert(CellInstArray(metal_escalator.cell_index(), t))
            path = Path([
                Point(me3.pinPoint('m_pin2').x, me3.pinPoint('m_pin2').y), 
                Point(me4.pinPoint('m_pin4').x, me4.pinPoint('m_pin4').y)], metal_width)
            sensor_circuit_cell.shapes(metalLayer1N).insert(path)
            path = Path([
                Point(me4.pinPoint('m_pin1').x, me4.pinPoint('m_pin1').y), 
                Point(pad_pin.x, pad_pin.y)], metal_width)
            sensor_circuit_cell.shapes(metalLayer2N).insert(path)
        else:
            # lower routes
            if pad_pin_rightcol_x == inst_bondpads_pchd[i].pinPoint('m_pin_left').x:
                # right column
                r_dx_col1 += -2*metal_width
                r_dx_col = r_dx_col1
            else:
                # left column
                r_dx_col2 += -2*metal_width
                r_dx_col = r_dx_col2                
            if pad_pin.y &lt; bondpad.bbox().height():
                # treat the bottom pad as a special case to avoid the Ge detector
                xpos = pad_pin.x+r_dx_col
                # check that the metal route doesn't overlap with the coupler bond pad routing
                if abs ( xpos - inst_bondpads_coupler[-1].pinPoint('m_pin_top').x ) &lt; 2*metal_width:
                    xpos = inst_bondpads_coupler[-1].pinPoint('m_pin_top').x - 2*metal_width
                t = Trans(Trans.R0, xpos , pchd_me[i].pinPoint('m_pin1').y)
                me3 = sensor_circuit_cell.insert(CellInstArray(metal_escalator.cell_index(), t))
                t = Trans(Trans.R0, pad_pin.x-metal_width/2, pad_pin.y)
                me4 = sensor_circuit_cell.insert(CellInstArray(metal_escalator.cell_index(), t))
                path = Path([
                    Point(me3.pinPoint('m_pin4').x, me3.pinPoint('m_pin4').y), 
                    Point(me3.pinPoint('m_pin4').x, inst_bondpads_pchd[i-1].pinPoint('m_pin_left').y-2*metal_width),
                    Point(me4.pinPoint('m_pin3').x, inst_bondpads_pchd[i-1].pinPoint('m_pin_left').y-2*metal_width),
                    Point(me4.pinPoint('m_pin3').x, me4.pinPoint('m_pin3').y),
                    Point(me4.pinPoint('m_pin1').x, me4.pinPoint('m_pin3').y)], metal_width)
                sensor_circuit_cell.shapes(metalLayer1N).insert(path)
            else:
                t = Trans(Trans.R0, pad_pin.x+r_dx_col, pchd_me[i].pinPoint('m_pin1').y)
                me3 = sensor_circuit_cell.insert(CellInstArray(metal_escalator.cell_index(), t))
                t = Trans(Trans.R0, pad_pin.x+r_dx_col, pad_pin.y)
                me4 = sensor_circuit_cell.insert(CellInstArray(metal_escalator.cell_index(), t))
                path = Path([
                    Point(me3.pinPoint('m_pin4').x, me3.pinPoint('m_pin4').y), 
                    Point(me4.pinPoint('m_pin2').x, me4.pinPoint('m_pin2').y)], metal_width)
                sensor_circuit_cell.shapes(metalLayer1N).insert(path)
                path = Path([
                    Point(me4.pinPoint('m_pin1').x, me4.pinPoint('m_pin1').y), 
                    Point(pad_pin.x, pad_pin.y)], metal_width)
                sensor_circuit_cell.shapes(metalLayer2N).insert(path)
        path = Path([
            Point(pchd_me[i].pinPoint('m_pin1').x, pchd_me[i].pinPoint('m_pin1').y), 
            Point(me3.pinPoint('m_pin3').x, me3.pinPoint('m_pin3').y)], metal_width)
        sensor_circuit_cell.shapes(metalLayer2N).insert(path)

    ########################################################################
    # PCHD electrical routing to the bond pads
    ########################################################################
    # metal routing from PCHD (top) to pads - Ground
    # vertical wires: M1
    # horizontal wires: M2
    # use the extra bond pad from the shifter pads
    pad_pin = inst_bondpads_pchd[-1].pinPoint('m_pin_left')
    # text label
    sub_cell.shapes(textLayerN).insert(pya.Text("e_pchd_GND", inst_bondpads_pchd[-1].trans)).text_size = 15/dbu
    # metal escalator
    t = Trans(Trans.R0, pad_pin.x-2*bondpad.bbox().width(), inst_si_pchd.pinPoint('elec1').y)
    me1 = sensor_circuit_cells[0].insert(CellInstArray(metal_escalator_gnd.cell_index(), t))
    t = Trans(Trans.R0, pad_pin.x-2*bondpad.bbox().width(), pad_pin.y)
    me2 = sensor_circuit_cells[0].insert(CellInstArray(metal_escalator_gnd.cell_index(), t))
    # horizontal wire
    path = Path([
        Point(sensor_pchd[0].pinPoint('elec1').x, sensor_pchd[0].pinPoint('elec1').y), 
        Point(me1.pinPoint('m_pin3').x, me1.pinPoint('m_pin3').y)], metal_width_gnd)
    sensor_circuit_cells[0].shapes(metalLayer2N).insert(path)
    # vertical wire
    path = Path([
        Point(me1.pinPoint('m_pin4').x, me1.pinPoint('m_pin4').y), 
        Point(me2.pinPoint('m_pin2').x, me2.pinPoint('m_pin2').y)], metal_width_gnd)
    sensor_circuit_cells[0].shapes(metalLayer1N).insert(path)
    # horizontal wire
    path = Path([
        Point(me2.pinPoint('m_pin1').x, me2.pinPoint('m_pin1').y), 
        Point(pad_pin.x, pad_pin.y)], metal_width_gnd)
    sensor_circuit_cells[0].shapes(metalLayer2N).insert(path)
    '''

    ########################################################################
    # Floor plan update: remove regions between the sensors 
    ########################################################################
    for i in range(0, fluidics_n_channels):
        for j in range(0, sensors_n_per_channel):
#            fp_unused_space_left[i][j] = fp_unused_space_left[0][j]
            fp_r1 = fp_r1 - Region(Box(Point(fp_unused_space_left[-1][j],fp_unused_space_bottom[i][j]), Point(fp_unused_space_right[i][j],fp_unused_space_top[i][j]) )) 
    # insert floorplan polygon
    sub_cell.shapes(fpLayerN).insert(fp_r1) 
    
    
    '''
    ########################################################################
    # SWG Ring sensors
    #  place rings inside the empty regions
    ########################################################################
    # swg rings
    swg_ring_cell = sub_cell.layout().create_cell("swg_rings")
    t = Trans(Trans.R0, 0, 0)
    sub_cell.insert(CellInstArray(swg_ring_cell.cell_index(), t))
    c = 0
    inst_swg_rings=[]
    # grating couplers
    inst_gc = []
    gc_pitch = to_itype(127,dbu)
    y_gc = chip_height - to_itype(70,dbu)
    x = sensor_x0
    for j in range(0, sensors_n_per_channel):
#    for j in range(0, 1):
        y = y0
        for i in range(2, fluidics_n_channels):
            t = Trans(Trans.R180, x + 27000 - 65000, 
                                y - fluidics_wall_width_inside/2 - fluidics_channel_width/2)
            inst_swg_rings.append(
              swg_ring_cell.insert(CellInstArray(swg_rings[c].cell_index(), t)) )
            t = Trans(Trans.R0, x + 27000, 
                                y - fluidics_wall_width_inside/2 - fluidics_channel_width/2)
            inst_swg_rings.append(
              swg_ring_cell.insert(CellInstArray(swg_rings[c+1].cell_index(), t)) )

            y += dy
        c += 2  # cycle through all the rings
        if c &gt;= len(swg_ring_parameters):
            c = 0
        x += dx
        
        # 5 GCs
        x_gc = to_itype(20,dbu) + j*to_itype(415,dbu)
        for k in range(5):
            t = Trans(Trans.R270, x_gc, y_gc) 
            inst_gc.append (
              swg_ring_cell.insert(CellInstArray(gc.cell_index(), t)) )
            if k==2:
                # Y branch tree for middle GC
                inst_in, inst_out, cell_tree = y_splitter_tree(top_cell, tree_depth=2, 
                    y_splitter_cell="y_splitter_adiabatic_si_1310_te_25_100_100", library=None, wg_type=wg_type, draw_waveguides=True)
                t = Trans(Trans.R270, 
                    x_gc-(cell_tree.bbox().top+cell_tree.bbox().bottom)/2, 
                    y_gc+cell_tree.bbox().left+50)
                swg_ring_cell.insert(CellInstArray(cell_tree.cell_index(), t))
#            if draw_waveguides:
#                connect_pins_with_waveguide(inst_esc_laser, 'opt1', inst_in, 'opt1', waveguide_type=wg_type, 
#                 turtle_A = [10,90], 
#                 turtle_B=[10,-90] )
            x_gc += gc_pitch
        if not(load_swg_ring_manualrouting):
            # bottom right 
            x_swg_wg_offset = 167
            y_swg_dist = 1820
            connect_pins_with_waveguide(inst_gc[-5], 'opt1', 
                inst_swg_rings[-3], 'pin2', waveguide_type=wg_type, 
                turtle_B=[10,-90, x_swg_wg_offset-4,-90, y_swg_dist-32,90 ], error_min_bend_radius=False)
            connect_pins_with_waveguide(inst_out[0], 'opt2', 
                inst_swg_rings[-3], 'pin1', waveguide_type=wg_type, 
                turtle_B=[10,90, x_swg_wg_offset-10,-90, y_swg_dist,90], error_min_bend_radius=False)
            # bottom left 
            connect_pins_with_waveguide(inst_gc[-4], 'opt1', 
                inst_swg_rings[-4], 'pin1', waveguide_type=wg_type, 
                turtle_B=[5,-90, x_swg_wg_offset-126.7-6,-90, y_swg_dist-20,90 ], error_min_bend_radius=False)
            connect_pins_with_waveguide(inst_out[0], 'opt3', 
                inst_swg_rings[-4], 'pin2', waveguide_type=wg_type, 
                turtle_B=[5,90, x_swg_wg_offset-126.7-8,-90, y_swg_dist,90], error_min_bend_radius=False)
            # top right 
            x_swg_wg_offset = 167-10
            y_swg_dist = 1820-400
            connect_pins_with_waveguide(inst_out[1], 'opt3', 
                inst_swg_rings[-1], 'pin2', waveguide_type=wg_type, 
                turtle_B=[10,-90, x_swg_wg_offset-4,-90, y_swg_dist+20,90 ], error_min_bend_radius=False)
            connect_pins_with_waveguide(inst_gc[-1], 'opt1', 
                inst_swg_rings[-1], 'pin1', waveguide_type=wg_type, 
                turtle_B=[10,90, x_swg_wg_offset-10,-90, y_swg_dist,90], error_min_bend_radius=False, 
                )#turtle_A=[10,-90, 5,90])
            # top left 
            connect_pins_with_waveguide(inst_out[1], 'opt2', 
                inst_swg_rings[-2], 'pin1', waveguide_type=wg_type, 
                turtle_B=[5,-90, x_swg_wg_offset-126.7-6,-90, y_swg_dist+20,90 ], error_min_bend_radius=False)
            connect_pins_with_waveguide(inst_gc[-2], 'opt1', 
                inst_swg_rings[-2], 'pin2', waveguide_type=wg_type, 
                turtle_B=[5,90, x_swg_wg_offset-126.7-8,-90, y_swg_dist,90], error_min_bend_radius=False,
                )#turtle_A=[5,-90, 10,90])


        y_gc += -to_itype(70,dbu)

    if load_swg_ring_manualrouting:
        dir_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), 
            "swg_rings_manualrouting.gds")
        ly.read(dir_path)
        routing_cell = ly.cell("swg_rings_manualrouting")
        t = Trans(Trans.R0, 0,0)
        swg_ring_cell.insert(CellInstArray(routing_cell.cell_index(), t))

    '''

    if save:
        # zoom out
        lv.clear_object_selection()
#        lv.zoom_fit()
        lv.max_hier()

        # Save a screenshot of the layout:
        dir_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), 
            "sensor_chip_g%s.png" % gasket_v)
        lv.save_screenshot(dir_path)

        # Save the layout, without PCell info, for fabrication
        save_options = pya.SaveLayoutOptions()
        save_options.write_context_info=False  # remove $$$CONTEXT_INFO$$$
        save_options.format='OASIS' # smaller file size
        save_options.oasis_compression_level=10
        save_options.oasis_permissive=True
        file_out = os.path.join(os.path.dirname(os.path.realpath(__file__)), 
            "../gds_in/sensor_chip_g%s.%s" % (gasket_v, save_options.format[0:3]))
        print("saving output %s: %s" % (save_options.format, file_out) )
        ly.write(file_out,save_options)
    

# Import KLayout-Python API
from pya import *

from time import time
t = time()

sensor_chip(save=True, partial=False, draw_waveguides=True, gasket_v=1, load_swg_ring_manualrouting=False)
#sensor_chip(save=True, partial=True, draw_waveguides=True, gasket_v=1)



print('Time elapsed: %s' % (time() - t))        </text>
</klayout-macro>
